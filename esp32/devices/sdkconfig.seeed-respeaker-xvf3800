# Seeed reSpeaker XVF3800 with XIAO ESP32-S3: 8 MB flash, 8 MB octal PSRAM.
# Load after sdkconfig.defaults. Requires the XVF3800's 16 kHz I2S-slave
# firmware; the ESP32-S3 is the I2S master.
# Pin sources: https://wiki.seeedstudio.com/respeaker_xvf3800_xiao_getting_started/
# and https://wiki.seeedstudio.com/respeaker_xvf3800_xiao_record_playback/
# I2S: BCLK=GPIO8, WS=GPIO7, DOUT=GPIO44, DIN=GPIO43.
# I2C: SDA=GPIO5, SCL=GPIO6, XVF3800 at 0x2C.
# The XIAO BOOT button is GPIO0. USB serial: Espressif 303a:1001.
# The 12-LED WS2812 ring is driven by the XVF3800 over I2C, not by a XIAO GPIO.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The uplink to Muse blackholes full-size segments: the TLS handshake takes
# seconds and an 8 KB chat frame stalls, while small control frames pass.
# 1200 bytes is safe behind PPPoE, VPNs and the tunnel's 1280-byte MTU.
CONFIG_LWIP_TCP_MSS=1200
CONFIG_HOMEHUB_LED_BACKEND_XVF3800=y
CONFIG_HOMEHUB_VOICE=y
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-respeaker"
# Talk button: the XIAO's own BOOT button on GPIO0, active low with the
# internal pull-up. Hold it to record a voice note; a tap starts a live call.
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_HOMEHUB_BUTTON_LABEL="BOOT"
# Grove Button (not fitted: the module went to a customer). It was SIG on
# GPIO1, active high, powered from GPIO4. Uncomment these and comment out the
# two lines above if the module is wired back in.
# CONFIG_HOMEHUB_BUTTON_ACTIVE_HIGH=y
# CONFIG_HOMEHUB_BUTTON_POWER_GPIO=4
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Live voice calls: a tap starts a call and Muse's spoken audio plays on the
# JST speaker. Holding the button still sends a text-reply voice note.
CONFIG_MUSE_REALTIME_VOICE=y
CONFIG_MUSE_REALTIME_VOICE_GREETING=y
# Groq TTS for held-button voice-note replies. The API key is not stored here:
# add CONFIG_MUSE_TTS_API_KEY="gsk_..." to the build's sdkconfig, which is
# gitignored, and leave this file free of secrets.
CONFIG_MUSE_TTS_ENABLE=y
CONFIG_MUSE_TTS_URL="https://tts.us.assemblyai.com/v1/openai/audio/speech"
CONFIG_MUSE_TTS_MODEL="assemblyai-tts-en"
CONFIG_MUSE_TTS_VOICE="alloy"
CONFIG_MUSE_TTS_RESPONSE_FORMAT="mp3"
CONFIG_MUSE_TTS_MAX_CHARS=800
CONFIG_MUSE_TTS_TIMEOUT_MS=15000
